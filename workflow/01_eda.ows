		<properties node_id="15" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x0cN\x00\x00\x01\xed\x00\x00\x0fm\x00\x00\x04`\x00\x00\x0cN\x00\x00\x02\t\x00\x00\x0fm\x00\x00\x04`\x00\x00\x00\x02\x00\x00\x00\x00\x0b\xc0\x00\x00\x0cN\x00\x00\x02\t\x00\x00\x0fm\x00\x00\x04`', 'scriptLibrary': [{'name': '실습 코드', 'script': '# ── 실습지 문제 1-6 추가과제 · IQR(Tukey) 이상치 탐지 ────────────────────────\nimport numpy as np\n\nCOL = "downtime_hours"\nx = np.asarray(in_data.get_column(COL), dtype=float)\n\nq1, q3 = np.nanpercentile(x, [25, 75])\niqr = q3 - q1\nlow, high = q1 - 1.5 * iqr, q3 + 1.5 * iqr\nmask = (x &lt; low) | (x &gt; high)\n\nprint(f"{COL}: Q1={q1:.1f} Q3={q3:.1f} IQR={iqr:.1f}")\nprint(f"경계 [{low:.1f}, {high:.1f}] · 이상치 {mask.sum()}건 "\n      f"({mask.sum() / len(x) * 100:.1f}%)")\nprint("→ 긴급정비처럼 \'의미 있는 극단값\'일 수 있으니 무조건 제거하지 말 것.")\n\nout_data = in_data[mask]     # 이상치만 내보낸다 (Data Table 로 확인)\n', 'filename': None}], 'scriptText': '# ── 실습지 문제 1-6 추가과제 · IQR(Tukey) 이상치 탐지 ────────────────────────\nimport numpy as np\n\nCOL = "downtime_hours"\nx = np.asarray(in_data.get_column(COL), dtype=float)\n\nq1, q3 = np.nanpercentile(x, [25, 75])\niqr = q3 - q1\nlow, high = q1 - 1.5 * iqr, q3 + 1.5 * iqr\nmask = (x &lt; low) | (x &gt; high)\n\nprint(f"{COL}: Q1={q1:.1f} Q3={q3:.1f} IQR={iqr:.1f}")\nprint(f"경계 [{low:.1f}, {high:.1f}] · 이상치 {mask.sum()}건 "\n      f"({mask.sum() / len(x) * 100:.1f}%)")\nprint("→ 긴급정비처럼 \'의미 있는 극단값\'일 수 있으니 무조건 제거하지 말 것.")\n\nout_data = in_data[mask]     # 이상치만 내보낸다 (Data Table 로 확인)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa8\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
